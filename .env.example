# Copy to .env (gitignored) and fill in. Never commit real values: this repo is public.

# Hackathon Atlas SANDBOX: Atlas -> Cluster0 -> Connect -> Drivers. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.fldedw.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=cooldown

LLM_PROVIDER=openai      # openai | anthropic
OPENAI_API_KEY=
LLM_MODEL_SMART=gpt-5.5          # Planner, Auditor
LLM_MODEL_FAST=gpt-5.4-mini      # world agents, Negotiator
LLM_CONCURRENCY=10
LLM_MODE=live            # live | cache_first | cache_only (golden-run replay)

# auto = Atlas Automated Embedding (no key needed). client = Voyage API from Python.
EMBED_MODE=auto
VOYAGE_API_KEY=
VOYAGE_API_URL=https://api.voyageai.com/v1/embeddings
VOYAGE_MODEL=voyage-4
VOYAGE_DIM=1024

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cooldown

SIM_HOUSEHOLDS=2000      # 10000 for the demo
SIM_SEED=42
TICK_SIM_MINUTES=5
TICK_REAL_SECONDS=1.5
API_BASE_URL=http://localhost:8000

NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
